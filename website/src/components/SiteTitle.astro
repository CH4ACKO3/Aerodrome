---
const siteTitleHref = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<div class="manual-brand">
  <a class="site-title" href={siteTitleHref} aria-label="概率飞行工程 · Probabilistic Aviation">
    <span class="site-title-zh" lang="zh-CN">概率飞行工程</span>
    <span class="site-title-en" lang="en" translate="no">Probabilistic Aviation</span>
  </a>
  <div class="reading-controls" aria-label="阅读布局">
    <button type="button" data-panel="left" aria-label="收起手册目录" title="收起手册目录" aria-expanded="true" aria-controls="starlight__sidebar" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16M5.5 8h1M5.5 12h1M5.5 16h1"/></svg>
    </button>
    <button type="button" data-panel="right" aria-label="收起本页目录" title="收起本页目录" aria-expanded="true" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16M17.5 8h1M17.5 12h1M17.5 16h1"/></svg>
    </button>
  </div>
</div>
<script is:inline>
  (() => {
    const root = document.documentElement;
    document.querySelectorAll('[data-panel]').forEach(button => {
      const side = button.dataset.panel;
      const key = 'manual-hide-' + side;
      const label = side === 'left' ? '手册目录' : '本页目录';
      const apply = hidden => {
        root.toggleAttribute('data-hide-' + side, hidden);
        button.setAttribute('aria-expanded', String(!hidden));
        button.setAttribute('aria-label', (hidden ? '展开' : '收起') + label);
        button.title = (hidden ? '展开' : '收起') + label;
      };
      try { apply(localStorage.getItem(key) === 'true'); } catch { apply(false); }
      button.hidden = false;
      button.addEventListener('click', () => {
        const hidden = !root.hasAttribute('data-hide-' + side);
        apply(hidden);
        try { localStorage.setItem(key, String(hidden)); } catch {}
      });
    });
  })();
</script>
<style>
  .manual-brand { display:flex; align-items:center; gap:1rem; min-width:0; }
  .site-title { display:flex; flex-direction:column; align-items:flex-start; justify-content:center; gap:.15rem; min-width:0; text-decoration:none; line-height:1.25; }
  .site-title-zh { font-size:1.05rem; font-weight:650; letter-spacing:.025em; white-space:nowrap; }
  .site-title-en { font-size:.72rem; font-weight:500; letter-spacing:0; color:var(--pa-muted); white-space:nowrap; }
  .reading-controls { display:none; gap:.25rem; }
  button { width:32px; height:32px; padding:6px; border:1px solid transparent; border-radius:6px; color:var(--pa-muted); background:transparent; cursor:pointer; }
  button:hover,button[aria-expanded='false'] { color:var(--sl-color-accent-high); background:var(--sl-color-accent-low); }
  button[hidden] { display:none; }
  @media(min-width:50rem) { .reading-controls { display:flex; } }
  @media(max-width:71.999rem) { button[data-panel='right'] { display:none; } }
</style>
